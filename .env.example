# Copia questo file in .env e compila i valori. NON committare .env.
# Le stesse variabili vanno impostate su Netlify (Site settings → Environment variables).

# --- Assistente AI (Netlify Function /api/chat) ---
# Chiave API Anthropic (obbligatoria perché il chatbot funzioni).
ANTHROPIC_API_KEY=""
# Modello del chatbot (facoltativo). Default: claude-opus-4-8. In produzione: claude-haiku-4-5.
CHAT_MODEL="claude-haiku-4-5"

# --- Recensioni Google auto-aggiornate (sezione Feedback, a build-time) ---
# Se impostata, le recensioni vengono lette dalla Google Places API a ogni build.
# Senza chiave restano le recensioni salvate nel componente.
GOOGLE_PLACES_API_KEY=""
# Place ID dell'attività su Google (facoltativo: default già nel codice).
GOOGLE_PLACE_ID="ChIJXY0xltn5gkcRMfqEcs8XTkk"

# --- Elenco contatti (Netlify Blobs) ---
# Token segreto del webhook /api/lead-ingest (stringa a caso, lunga).
# Nessun database esterno, nessun costo.
LEAD_WEBHOOK_TOKEN=""
# Chiave di accesso alla pagina privata /api/contatti, da scrivere nel modulo
# della pagina. Se manca si usa LEAD_WEBHOOK_TOKEN, ma è meglio tenerle diverse.
# Gli header di sicurezza della pagina sono nel codice (lead-elenco.mjs):
# quelli di netlify.toml non si applicano alle Functions.
LEAD_ADMIN_TOKEN=""

# --- Ricostruzione settimanale del sito (recensioni Google) ---
# Build hook di Netlify, usato dalla funzione schedulata aggiorna-recensioni.
BUILD_HOOK_URL=""
