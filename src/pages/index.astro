---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, BUSINESS } from '../consts';
import Feedback from '../components/Feedback.astro';
import NosLabCoin from '../components/NosLabCoin.astro';
import hero from '../assets/hero-venezia.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.ordine - b.data.ordine);
---

<BaseLayout description={SITE_DESCRIPTION}>
  {/* Hero */}
  <section class="mx-auto max-w-5xl px-6 pt-14 pb-16 sm:pt-20">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold tracking-widest text-neutral-500 uppercase">
          Ti do il benvenuto in GSA
        </p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-6xl">
          Grassi <span class="evidenzia">Simona Adele</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-neutral-700 sm:text-xl">
          Consulente digitale e fotografa. Risolvo problemi con efficienza, chiarezza e tanta
          energia.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/contatti/"
            class="bg-brand text-ink rounded-full px-6 py-3 font-semibold transition hover:brightness-95"
          >
            Contattami
          </a>
          <a
            href="/servizi/"
            class="text-ink rounded-full border border-neutral-300 px-6 py-3 font-semibold transition hover:bg-neutral-100"
          >
            Scopri i servizi
          </a>
          <NosLabCoin />
        </div>
      </div>

      <div class="reveal relative">
        <Image
          src={hero}
          alt="Simona Grassi con la macchina fotografica su una gondola a Venezia"
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 40vw, 90vw"
          class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl"
          loading="eager"
          fetchpriority="high"
        />
        <span
          class="bg-brand-lime absolute -bottom-4 -left-4 -z-10 h-24 w-24 rounded-3xl sm:h-32 sm:w-32"
          aria-hidden="true"></span>
      </div>
    </div>
  </section>

  {/* Intro */}
  <section class="reveal mx-auto max-w-3xl px-6 py-12">
    <p class="text-lg leading-relaxed text-neutral-700">
      GSA di Grassi Simona Adele è un'attività polivalente con base a
      <span class="evidenzia-lime">Peio</span>, nel cuore della Val di Pejo. Mi occupo soprattutto
      di consulenza per la pubblicità digitale, social e promozione, di servizi fotografici e della
      gestione dell'ufficio, per aziende e privati del Trentino, del Bresciano e del Bergamasco.
    </p>
  </section>

  {/* Servizi in evidenza */}
  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Servizi offerti</h2>
      <a
        href="/servizi/"
        class="decoration-brand text-sm font-medium underline decoration-2 underline-offset-4"
        >Tutti i servizi</a
      >
    </div>
    <ul class="reveal mt-8 grid gap-5 [perspective:1000px] sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <li>
            <a
              href={`/servizi/#${s.id}`}
              data-tilt
              class="group hover:border-brand block h-full rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm transition-[transform,box-shadow,border-color] duration-200 will-change-transform [transform-style:preserve-3d] hover:shadow-2xl"
            >
              <h3 class="text-ink font-bold">{s.data.titolo}</h3>
              <p class="mt-2 text-sm text-neutral-600">{s.data.descrizione}</p>
              <span class="group-hover:text-ink mt-4 inline-flex items-center gap-1 text-sm font-semibold text-neutral-400 transition">
                Scopri di più
                <span class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))
      }

      {/* Sesta card: la sinergia con NosLab, per chiudere la griglia */}
      <li>
        <a
          href="/servizi/#noslab"
          data-tilt
          class="group bg-ink relative block h-full overflow-hidden rounded-2xl p-6 shadow-sm transition-[transform,box-shadow] duration-200 will-change-transform [transform-style:preserve-3d] hover:shadow-2xl"
        >
          <span
            class="from-brand via-brand-lime to-brand absolute inset-x-0 top-0 h-1 bg-gradient-to-r"
            aria-hidden="true"></span>

          {/* Moneta NosLab che ruota sul proprio asse */}
          <span class="moneta-mini" aria-hidden="true">
            <svg viewBox="21.51 84.85 523.91 397.24">
              <path
                fill="#202139"
                d="M 475.171875 283.394531 L 475.171875 411.800781 L 373.269531 411.800781 L 373.269531 283.394531 C 373.269531 233.851562 332.945312 193.578125 283.40625 193.578125 C 233.863281 193.578125 193.585938 233.851562 193.585938 283.394531 L 193.585938 475.164062 L 91.6875 475.164062 L 91.6875 283.394531 C 91.6875 177.515625 177.527344 91.679688 283.40625 91.679688 C 389.332031 91.679688 475.171875 177.515625 475.171875 283.394531"
              ></path>
              <path
                fill="#5f9e1f"
                d="M 74.226562 475.164062 L 28.34375 475.164062 L 28.34375 429.28125 L 74.226562 429.28125 Z M 74.226562 475.164062"
              ></path>
              <path
                fill="#5f9e1f"
                d="M 538.515625 429.300781 L 211.042969 429.300781 L 211.042969 475.179688 L 538.515625 475.179688 Z M 538.515625 429.300781"
              ></path>
            </svg>
          </span>

          <h3 class="text-brand mt-3 font-bold">Tecnologia su misura</h3>
          <p class="mt-2 text-sm text-white/70">
            Con NosLab: piattaforme e gestionali personalizzati, sistemi di coupon e assistenti
            automatici per la tua attività.
          </p>
          <span
            class="group-hover:text-brand mt-4 inline-flex items-center gap-1 text-sm font-semibold text-white/50 transition"
          >
            Scopri di più
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>
      </li>
    </ul>
  </section>

  {/* Feedback / testimonianze */}
  <Feedback />

  {/* CTA finale */}
  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="reveal bg-ink rounded-3xl p-8 text-center text-white sm:p-14">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
        Parliamo del tuo <span class="text-brand">progetto</span>
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-neutral-300">
        Un sito, una campagna social, un servizio fotografico o la gestione della fatturazione?
        Scrivimi o chiamami, troviamo insieme la soluzione.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        {/* Telefono a disco: chiama senza esporre il numero agli spam-bot. */}
        <a
          href={`tel:${BUSINESS.phoneE164}`}
          aria-label="Chiamami"
          title="Chiamami"
          class="bg-brand text-ink group grid h-14 w-14 place-items-center rounded-full transition hover:brightness-95 motion-safe:hover:-rotate-12"
        >
          <svg
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8"
            aria-hidden="true"
          >
            {/* cornetta */}
            <path d="M13 14c1.5-3 6-4.5 11-4.5S33.5 11 35 14"></path>
            <rect x="6.5" y="11.5" width="8" height="6" rx="3"></rect>
            <rect x="33.5" y="11.5" width="8" height="6" rx="3"></rect>
            {/* corpo e disco combinatore */}
            <path
              d="M9 35c0-7.2 6.7-13 15-13s15 5.8 15 13v1.5a2.5 2.5 0 0 1-2.5 2.5h-25A2.5 2.5 0 0 1 9 36.5z"
            ></path>
            <circle cx="24" cy="31.5" r="6.5"></circle>
            <circle cx="24" cy="31.5" r="1.5" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a
          href="/contatti/"
          class="rounded-full border border-white/30 px-6 py-3 font-semibold text-white transition hover:bg-white/10"
        >
          Vai ai contatti
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Moneta della sesta card: gira sul proprio asse con una pausa fra un giro e l'altro. */
    .moneta-mini {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: radial-gradient(circle at 34% 27%, #fffdf0, #ffef8a 22%, #ffdd00 54%, #e0a800);
      box-shadow:
        inset 0 1px 2px rgba(255, 255, 255, 0.9),
        0 0 14px -2px rgba(255, 221, 0, 0.6);
    }
    .moneta-mini svg {
      width: 62%;
      height: auto;
    }

    @media (prefers-reduced-motion: no-preference) {
      .moneta-mini {
        animation: moneta-gira 7s ease-in-out infinite;
      }
      @keyframes moneta-gira {
        0%,
        55% {
          transform: rotateY(0deg);
        }
        100% {
          transform: rotateY(360deg);
        }
      }
    }
  </style>

  <script is:inline>
    (function () {
      if (!window.matchMedia) return;
      if (!matchMedia('(pointer: fine)').matches) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('[data-tilt]').forEach(function (card) {
        card.addEventListener('mousemove', function (e) {
          var r = card.getBoundingClientRect();
          var px = (e.clientX - r.left) / r.width - 0.5;
          var py = (e.clientY - r.top) / r.height - 0.5;
          card.style.transform =
            'perspective(900px) rotateX(' +
            (-py * 7).toFixed(2) +
            'deg) rotateY(' +
            (px * 7).toFixed(2) +
            'deg) translateY(-6px)';
        });
        card.addEventListener('mouseleave', function () {
          card.style.transform = '';
        });
      });
    })();
  </script>
</BaseLayout>
