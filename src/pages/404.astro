---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV, BUSINESS } from '../consts';
---

<BaseLayout
  title="Pagina non trovata"
  description="La pagina che cercavi non esiste o è stata spostata."
  noindex={true}
>
  <div class="mx-auto max-w-2xl px-6 py-20 text-center sm:py-28">
    <p class="text-sm font-semibold tracking-widest text-neutral-500 uppercase">Errore 404</p>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl">
      Questa pagina <span class="evidenzia">non c'è più</span>
    </h1>
    <p class="mt-5 text-lg text-neutral-700">
      Forse arrivi da un vecchio collegamento: il sito è stato rifatto e alcune pagine hanno
      cambiato indirizzo. Da qui trovi tutto quello che ti serve.
    </p>

    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      {
        NAV.map((voce) => (
          <li>
            <a
              href={voce.href}
              class="hover:border-brand inline-block rounded-full border border-neutral-300 px-5 py-2.5 font-medium transition hover:bg-neutral-100"
            >
              {voce.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-neutral-600">
      Ti serve una mano subito? Scrivimi a
      <a
        class="decoration-brand font-medium underline decoration-2 underline-offset-4"
        href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a
      >
      oppure chiamami.
    </p>

    <div class="mt-6">
      <a
        href="/"
        class="bg-brand text-ink inline-block rounded-full px-6 py-3 font-semibold transition hover:brightness-95"
      >
        Torna alla home
      </a>
    </div>
  </div>
</BaseLayout>
