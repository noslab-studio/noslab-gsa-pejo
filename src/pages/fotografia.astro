---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaPagina from '../components/SchemaPagina.astro';
import { SITE_URL, SITE_NAME } from '../consts';

// Import automatico di tutte le foto della gallery.
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/foto/*.{jpg,jpeg,png}', {
  eager: true,
});
const gallery = Object.values(modules).map((m) => m.default);

// Versione grande (per il lightbox a schermo intero).
const items = await Promise.all(
  gallery.map(async (img) => {
    const full = await getImage({ src: img, width: 1600, format: 'webp' });
    return { img, fullSrc: full.src };
  }),
);

const categorie = [
  'Aziendale e commerciale',
  'Piccoli eventi',
  'Calendari',
  'Famiglia e gravidanza',
  'Paesaggi della Val di Pejo',
];
---

<BaseLayout
  title="Fotografia"
  description="Servizi fotografici a Peio: aziendale e commerciale, eventi, calendari, famiglia e gravidanza, paesaggi della Val di Pejo. Sfoglia lo showroom."
>
  <SchemaPagina
    slot="jsonld"
    titolo="Fotografia"
    percorso="/fotografia/"
    extra={{
      '@type': 'ImageGallery',
      url: `${SITE_URL}/fotografia/`,
      name: `Portfolio fotografico di ${SITE_NAME}`,
      about: 'Fotografia aziendale e commerciale, eventi, famiglia e gravidanza, paesaggi alpini',
      author: { '@id': `${SITE_URL}/#owner` },
      numberOfItems: gallery.length,
    }}
  />

  {/* Intro */}
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-8 sm:pt-20">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
      <span class="evidenzia">Fotografia</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-neutral-700">
      Servizi fotografici a fini pubblicitari e commerciali, ma anche i momenti più personali. Tutto
      in formato digitale.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        categorie.map((c) => (
          <li class="rounded-full bg-neutral-100 px-3 py-1 text-sm text-neutral-700">{c}</li>
        ))
      }
    </ul>
  </section>

  {/* Showroom immersivo */}
  <section class="bg-ink relative py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-center text-sm font-semibold tracking-widest text-white/50 uppercase">
        La galleria
      </p>
      <h2 class="mt-2 text-center text-3xl font-extrabold text-white sm:text-4xl">
        Entra nello <span class="text-brand">showroom</span>
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-center text-sm text-white/60">
        Passa sopra un'immagine e clicca per aprirla a schermo intero.
      </p>

      <div id="showroom" class="showroom mt-12 columns-2 gap-4 sm:columns-3 lg:gap-6">
        {
          items.map((it, i) => (
            <button
              type="button"
              class="tile group mb-4 block w-full overflow-hidden rounded-xl ring-1 ring-white/10 lg:mb-6"
              data-full={it.fullSrc}
              data-index={i}
              aria-label={`Apri la fotografia ${i + 1} a schermo intero`}
            >
              <Image
                src={it.img}
                alt={`Scatto ${i + 1} dal portfolio fotografico di GSA di Grassi Simona Adele`}
                widths={[300, 500, 800]}
                sizes="(min-width: 1024px) 30vw, 45vw"
                class="w-full object-cover transition duration-500 group-hover:scale-[1.06]"
                loading={i < 4 ? 'eager' : 'lazy'}
              />
            </button>
          ))
        }
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="mx-auto max-w-5xl px-6 py-14">
    <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 text-neutral-700">
      <p>
        Vuoi un servizio fotografico su misura? <a
          href="/contatti/"
          class="decoration-brand font-semibold underline decoration-2 underline-offset-4"
          >Scrivimi</a
        > e ne parliamo.
      </p>
      <p class="mt-3 text-sm">
        Modulo per l'uso delle immagini: <a
          href="/modulo-liberatoria.html"
          target="_blank"
          rel="noopener"
          class="decoration-brand font-semibold underline decoration-2 underline-offset-4"
          >scarica la liberatoria (PDF)</a
        >.
      </p>
    </div>
  </section>

  {/* Lightbox a schermo intero */}
  <dialog id="lightbox" class="lightbox" aria-label="Anteprima fotografia a schermo intero">
    <button type="button" class="lb-btn lb-close" data-close aria-label="Chiudi">&times;</button>
    <button type="button" class="lb-btn lb-prev" data-prev aria-label="Fotografia precedente"
      >&lsaquo;</button
    >
    <img id="lb-img" alt="Fotografia a schermo intero" />
    <button type="button" class="lb-btn lb-next" data-next aria-label="Fotografia successiva"
      >&rsaquo;</button
    >
  </dialog>

  <style>
    /* Spotlight: attenua le altre foto quando ne guardi una. */
    .tile {
      transition: opacity 0.4s ease;
      cursor: pointer;
    }
    .showroom:has(.tile:hover) .tile:not(:hover) {
      opacity: 0.4;
    }

    /* Lightbox */
    .lightbox {
      max-width: 96vw;
      max-height: 96vh;
      margin: auto;
      border: none;
      background: transparent;
      padding: 0;
      overflow: visible;
    }
    .lightbox::backdrop {
      background: rgba(10, 10, 8, 0.88);
      backdrop-filter: blur(3px);
    }
    #lb-img {
      display: block;
      max-width: 92vw;
      max-height: 88vh;
      border-radius: 0.5rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    }
    .lb-btn {
      position: fixed;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #16160f;
      background: #ffdd00;
      border-radius: 9999px;
      line-height: 1;
      cursor: pointer;
    }
    .lb-close {
      top: 1rem;
      right: 1rem;
      height: 2.75rem;
      width: 2.75rem;
      font-size: 1.6rem;
    }
    .lb-prev,
    .lb-next {
      top: 50%;
      transform: translateY(-50%);
      height: 3rem;
      width: 3rem;
      font-size: 2rem;
    }
    .lb-prev {
      left: 1rem;
    }
    .lb-next {
      right: 1rem;
    }
    .lb-btn:hover {
      filter: brightness(0.95);
    }

    @media (prefers-reduced-motion: reduce) {
      .tile,
      #showroom .tile img {
        transition: none !important;
      }
      .showroom:has(.tile:hover) .tile:not(:hover) {
        opacity: 1;
      }
    }
  </style>

  <script is:inline>
    (function () {
      var dlg = document.getElementById('lightbox');
      var img = document.getElementById('lb-img');
      if (!dlg || !img) return;
      var tiles = Array.prototype.slice.call(document.querySelectorAll('#showroom .tile'));
      var idx = 0;
      function show(i) {
        idx = (i + tiles.length) % tiles.length;
        img.src = tiles[idx].getAttribute('data-full');
      }
      tiles.forEach(function (t) {
        t.addEventListener('click', function () {
          show(parseInt(t.getAttribute('data-index'), 10) || 0);
          if (typeof dlg.showModal === 'function') dlg.showModal();
          else dlg.setAttribute('open', '');
        });
      });
      dlg.querySelector('[data-close]').addEventListener('click', function () {
        dlg.close();
      });
      dlg.querySelector('[data-prev]').addEventListener('click', function () {
        show(idx - 1);
      });
      dlg.querySelector('[data-next]').addEventListener('click', function () {
        show(idx + 1);
      });
      dlg.addEventListener('click', function (e) {
        if (e.target === dlg) dlg.close();
      });
      document.addEventListener('keydown', function (e) {
        if (!dlg.open) return;
        if (e.key === 'ArrowLeft') show(idx - 1);
        if (e.key === 'ArrowRight') show(idx + 1);
      });
    })();
  </script>
</BaseLayout>
