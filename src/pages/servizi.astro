---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.ordine - b.data.ordine);
const rendered = await Promise.all(
  services.map(async (s) => ({ data: s.data, Content: (await render(s)).Content })),
);
---

<BaseLayout
  title="Servizi"
  description="Pubblicità digitale e social, servizi fotografici, pubblicità tradizionale, gestione ufficio e fatturazione elettronica."
>
  <div class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Servizi offerti</h1>
    <p class="mt-4 text-lg text-neutral-300">
      Un'attività polivalente: dalla comunicazione digitale alla fotografia, fino alla gestione
      amministrativa. Ecco di cosa mi occupo.
    </p>

    <div class="mt-12 space-y-10">
      {
        rendered.map(({ data, Content }) => (
          <section class="border-t border-white/10 pt-8">
            <h2 class="text-2xl font-semibold text-amber-400">{data.titolo}</h2>
            <p class="mt-2 font-medium text-neutral-200">{data.descrizione}</p>
            <div class="mt-3 leading-relaxed text-neutral-300">
              <Content />
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
