---
/**
 * Sezione dedicata a ciò che Simona può offrire grazie alla collaborazione con NosLab:
 * sviluppo su misura, ecosistemi gestionali, coupon, assistenti AI.
 */
const capacita = [
  {
    titolo: 'Siti e piattaforme su misura',
    testo:
      'Niente template preconfezionati: siti costruiti riga per riga, velocissimi e pensati per farsi trovare su Google. Questo sito è un esempio di cosa realizziamo.',
  },
  {
    titolo: 'Ecosistemi per la gestione aziendale',
    testo:
      'Gestionali e pannelli di controllo su misura che mettono ordine nel lavoro quotidiano: preventivi, clienti, scadenze e documenti in un unico posto, collegati agli strumenti che usi già.',
  },
  {
    titolo: 'Sistema di coupon e fidelizzazione',
    testo:
      'Buoni sconto digitali, raccolte punti e promozioni tracciabili: strumenti concreti per far tornare i clienti e capire quali campagne funzionano davvero.',
  },
  {
    titolo: 'Assistenti AI e automazioni',
    testo:
      'Assistenti che rispondono ai tuoi clienti 24 ore su 24, come quello che trovi in questo sito, e automazioni che tolgono di mezzo il lavoro ripetitivo.',
  },
  {
    titolo: 'Aree riservate e formazione online',
    testo:
      'Piattaforme per corsi, contenuti riservati ai soci o ai clienti, con accessi personali e materiali scaricabili.',
  },
  {
    titolo: 'Dati alla mano',
    testo:
      'Report e misurazioni chiare per sapere cosa sta portando risultati, senza dover interpretare numeri incomprensibili.',
  },
];
---

<section
  class="reveal bg-ink relative mt-12 overflow-hidden rounded-3xl px-6 py-12 text-white sm:px-10 sm:py-14"
>
  {/* barra d'accento NosLab */}
  <div class="from-brand via-brand-lime to-brand absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r">
  </div>

  <p class="text-sm font-semibold tracking-widest text-white/50 uppercase">
    In più, insieme a NosLab
  </p>
  <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
    Quando serve <span class="text-brand">tecnologia su misura</span>
  </h2>

  <div class="mt-4 max-w-3xl space-y-3 leading-relaxed text-white/75">
    <p>
      Oltre alla comunicazione e alla fotografia, collaboro con <strong class="text-white"
        >NosLab</strong
      >, una realtà che sviluppa software e strumenti digitali su misura. Questo significa che, se
      la tua attività ha bisogno di qualcosa che va oltre il sito vetrina, non devi cercare altrove:
      ci pensiamo noi, con un unico interlocutore che sei abituato a sentire.
    </p>
    <p>
      Dalla piattaforma gestionale che semplifica il lavoro di ogni giorno, al sistema di coupon per
      fidelizzare i clienti, fino agli assistenti automatici che rispondono al posto tuo quando sei
      impegnata: sono strumenti pensati per far crescere l'attività, non per complicarla.
    </p>
  </div>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      capacita.map((c) => (
        <li class="hover:border-brand/60 rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:bg-white/10">
          <h3 class="text-brand font-bold">{c.titolo}</h3>
          <p class="mt-2 text-sm text-white/70">{c.testo}</p>
        </li>
      ))
    }
  </ul>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a
      href="/contatti/"
      class="bg-brand text-ink rounded-full px-6 py-3 font-semibold transition hover:brightness-95"
    >
      Parliamone insieme
    </a>
    <a
      href="https://noslab.it"
      target="_blank"
      rel="noopener"
      class="decoration-brand-lime text-sm font-medium text-white/70 underline decoration-2 underline-offset-4 transition hover:text-white"
    >
      Scopri NosLab
    </a>
  </div>
</section>
