---
// Avviso informativo cookie. Il sito usa solo cookie tecnici (nessuna profilazione),
// quindi non è un consenso obbligatorio ma un'informativa dismissibile.
---

<div
  id="cookie-banner"
  hidden
  role="region"
  aria-label="Informativa cookie"
  class="fixed bottom-5 left-5 z-50 max-w-sm rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xl"
>
  <p class="text-sm text-neutral-700">
    Usiamo solo <strong class="text-ink">cookie tecnici essenziali</strong> per far funzionare il sito.
    Nessuna profilazione né tracciamento. Dettagli nella
    <a
      href="/cookie-policy/"
      class="decoration-brand font-medium underline decoration-2 underline-offset-2"
      >Cookie Policy</a
    >.
  </p>
  <div class="mt-3 flex justify-end">
    <button
      type="button"
      id="cookie-ok"
      class="text-ink bg-brand rounded-full px-4 py-2 text-sm font-semibold transition hover:brightness-95"
    >
      Ho capito
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var b = document.getElementById('cookie-banner');
    if (!b) return;
    try {
      if (localStorage.getItem('gsa-cookie-ok') === '1') return;
    } catch (e) {}
    b.hidden = false;
    var ok = document.getElementById('cookie-ok');
    if (ok)
      ok.addEventListener('click', function () {
        b.hidden = true;
        try {
          localStorage.setItem('gsa-cookie-ok', '1');
        } catch (e) {}
      });
  })();
</script>
