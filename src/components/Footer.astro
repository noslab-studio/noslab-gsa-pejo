---
import { SITE_NAME, BUSINESS } from '../consts';
const year = new Date().getFullYear();
const a = BUSINESS.address;
---

<footer class="mt-24 border-t border-neutral-200 bg-neutral-50">
  <div class="mx-auto grid max-w-5xl gap-8 px-6 py-12 sm:grid-cols-3">
    <div>
      <p class="text-ink text-base font-bold">{SITE_NAME}</p>
      <p class="mt-2 text-sm text-neutral-600">Consulenza digitale, social e fotografia</p>
    </div>

    <address class="text-sm text-neutral-600 not-italic">
      <p class="text-ink font-semibold">Contatti</p>
      <p class="mt-2">{a.street}<br />{a.postalCode} {a.city} ({a.province})</p>
      <p class="mt-2">
        <a
          class="decoration-brand hover:text-ink underline decoration-2 underline-offset-4"
          href={`tel:${BUSINESS.phoneE164}`}>{BUSINESS.phone}</a
        >
      </p>
      <p>
        <a
          class="decoration-brand hover:text-ink underline decoration-2 underline-offset-4"
          href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a
        >
      </p>
    </address>

    <div class="text-sm text-neutral-600">
      <p class="text-ink font-semibold">Impresa</p>
      <p class="mt-2">Impresa individuale<br />P.IVA {BUSINESS.vatId}</p>
    </div>
  </div>

  <div class="border-t border-neutral-200">
    <p class="mx-auto max-w-5xl px-6 py-4 text-xs text-neutral-500">
      © {year}
      {SITE_NAME}. Tutti i diritti riservati.
    </p>
  </div>
</footer>
