---
/**
 * Sezione testimonianze.
 * Recensioni reali da Google. Se è impostata la variabile GOOGLE_PLACES_API_KEY
 * (su Netlify), le recensioni vengono lette dalla Google Places API a ogni build,
 * così restano aggiornate; altrimenti si usano quelle salvate qui sotto.
 * Non inserire recensioni non autentiche.
 */
const PLACE_ID = process.env.GOOGLE_PLACE_ID || 'ChIJXY0xltn5gkcRMfqEcs8XTkk';
const PLACES_KEY = process.env.GOOGLE_PLACES_API_KEY;

// Scheda Google (per leggere le recensioni) e modulo "scrivi una recensione".
const GOOGLE_URL = 'https://www.google.com/maps?cid=5282185592699157041';
const WRITE_URL = `https://search.google.com/local/writereview?placeid=${PLACE_ID}`;

// Fallback: recensioni reali correnti (usate se la Places API non è configurata).
let ratingRaw = 5;
let count = 3;
let testimonianze = [
  {
    testo:
      'Simona è una bomba di energia allo stato puro. Grazie a lei sono riuscita a migliorare l’organico delle mie pagine social. Super disponibile anche come orari e giornate! La ricontatterò a breve per un’altra campagna pubblicitaria!',
    autore: 'Camilla Trantini',
    fonte: 'Google · Local Guide',
  },
  {
    testo:
      'Abbiamo avuto il piacere di vedere Simona all’opera durante un raduno cinofilo: ottima professionalità e disponibilità, ci ha regalato dei bellissimi scatti. Consigliatissima!',
    autore: 'Alessio Bongiovanni',
    fonte: 'Google',
  },
];

// Aggiornamento automatico (a build-time) dalle recensioni Google, se configurata la chiave.
if (PLACES_KEY) {
  try {
    const url = `https://maps.googleapis.com/maps/api/place/details/json?place_id=${PLACE_ID}&fields=rating,user_ratings_total,reviews&language=it&reviews_sort=newest&key=${PLACES_KEY}`;
    const res = await fetch(url);
    const data = await res.json();
    if (data.status === 'OK' && data.result) {
      if (typeof data.result.rating === 'number') ratingRaw = data.result.rating;
      if (typeof data.result.user_ratings_total === 'number')
        count = data.result.user_ratings_total;
      const revs = (data.result.reviews || [])
        .filter((r: any) => r.text && String(r.text).trim())
        .slice(0, 4)
        .map((r: any) => ({
          testo: String(r.text).trim(),
          autore: r.author_name,
          fonte: 'Google',
        }));
      if (revs.length) testimonianze = revs;
    }
  } catch {
    /* in caso di errore restano le recensioni salvate sopra */
  }
}

const GOOGLE_RATING = ratingRaw.toFixed(1).replace('.', ',');
const GOOGLE_COUNT = count;
const Stelle = (size: string) => Array.from({ length: 5 }).map(() => size);
---

<section id="recensioni" class="reveal mx-auto max-w-5xl scroll-mt-24 px-6 py-12">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
      Dicono <span class="evidenzia">di me</span>
    </h2>
    <a
      href={GOOGLE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="decoration-brand text-sm font-medium underline decoration-2 underline-offset-4"
    >
      Leggi le recensioni su Google
    </a>
  </div>

  {/* Rating aggregato Google */}
  <div class="mt-6 flex items-center gap-3">
    <span class="text-4xl font-extrabold">{GOOGLE_RATING}</span>
    <div>
      <div class="text-brand flex" aria-hidden="true">
        {
          Stelle('h-5 w-5').map((c) => (
            <svg viewBox="0 0 20 20" fill="currentColor" class={c}>
              <path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" />
            </svg>
          ))
        }
      </div>
      <p class="mt-1 text-sm text-neutral-600">
        {GOOGLE_RATING} su 5 · {GOOGLE_COUNT} recensioni su Google
      </p>
    </div>
  </div>

  {/* Testimonianze */}
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      testimonianze.map((t) => (
        <li class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
          <div class="text-brand flex" aria-hidden="true">
            {Stelle('h-4 w-4').map((c) => (
              <svg viewBox="0 0 20 20" fill="currentColor" class={c}>
                <path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" />
              </svg>
            ))}
          </div>
          <blockquote class="mt-3 leading-relaxed text-neutral-800">“{t.testo}”</blockquote>
          <p class="mt-4 text-sm">
            <span class="text-ink font-semibold">{t.autore}</span>
            <span class="text-neutral-500"> · {t.fonte}</span>
          </p>
        </li>
      ))
    }
  </ul>

  {/* Lascia una recensione: apre il modulo Google in un popup */}
  <div class="mt-8">
    <a
      href={WRITE_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-review-popup
      class="text-ink bg-brand inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold transition hover:brightness-95"
    >
      <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
        <path
          d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z"
        ></path>
      </svg>
      Lascia una recensione
    </a>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-review-popup]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        var w = 520,
          h = 700;
        var left = Math.max(0, (screen.width - w) / 2);
        var top = Math.max(0, (screen.height - h) / 2);
        var win = window.open(
          el.href,
          'gsa-recensione',
          'width=' + w + ',height=' + h + ',left=' + left + ',top=' + top + ',noopener,noreferrer',
        );
        // Se il popup è bloccato, lascia proseguire il link normale (nuova scheda).
        if (win) e.preventDefault();
      });
    });
  </script>
</section>
