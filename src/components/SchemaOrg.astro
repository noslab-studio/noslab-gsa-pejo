---
/**
 * Structured data site-wide (JSON-LD): ProfessionalService (estende LocalBusiness)
 * + Person (la titolare), collegati in un @graph. Presente su ogni pagina.
 */
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION, BUSINESS, DEFAULT_OG_IMAGE } from '../consts';

const businessId = `${SITE_URL}/#business`;
const personId = `${SITE_URL}/#owner`;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': businessId,
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      url: SITE_URL,
      image: new URL(DEFAULT_OG_IMAGE, SITE_URL).href,
      telephone: BUSINESS.phoneE164,
      email: BUSINESS.email,
      vatID: BUSINESS.vatId,
      founder: { '@id': personId },
      address: {
        '@type': 'PostalAddress',
        streetAddress: BUSINESS.address.street,
        postalCode: BUSINESS.address.postalCode,
        addressLocality: BUSINESS.address.city,
        addressRegion: BUSINESS.address.province,
        addressCountry: BUSINESS.address.country,
      },
      areaServed: BUSINESS.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
      knowsAbout: [
        'Pubblicità digitale',
        'Social media',
        'Fotografia commerciale',
        'Gestione ufficio',
        'Fatturazione elettronica',
      ],
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: BUSINESS.ownerName,
      jobTitle: 'Consulente digitale e fotografa',
      worksFor: { '@id': businessId },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
