---
import { Image } from 'astro:assets';
import { NAV } from '../consts';
import logo from '../assets/logo-gsa.png';

// Normalizza il pathname corrente per evidenziare la voce attiva.
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === current;
};

// Voce di nav con sottolineatura animata giallo → lime (hover e pagina attiva).
const linkBase =
  'relative py-1 font-medium text-neutral-700 transition-colors hover:text-ink ' +
  'after:pointer-events-none after:absolute after:-bottom-0.5 after:left-0 after:h-[3px] after:w-full ' +
  'after:origin-left after:scale-x-0 after:rounded-full after:bg-gradient-to-r after:from-brand after:to-brand-lime ' +
  'motion-safe:after:transition-transform motion-safe:after:duration-300 hover:after:scale-x-100 ' +
  'aria-[current=page]:font-semibold aria-[current=page]:text-ink aria-[current=page]:after:scale-x-100';
---

<header
  id="site-header"
  class="sticky top-0 z-30 border-b border-neutral-200 bg-white/80 backdrop-blur"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
    <a
      href="/"
      class="group flex items-center gap-2.5"
      aria-label="GSA di Grassi Simona Adele, home"
    >
      <span
        class="bg-ink flex h-10 w-10 items-center justify-center rounded-xl motion-safe:transition-transform motion-safe:duration-700 motion-safe:ease-out motion-safe:group-hover:rotate-[360deg]"
      >
        <Image src={logo} alt="" width={30} height={30} class="h-7 w-7" />
      </span>
      <span class="text-ink text-base font-extrabold tracking-tight">GSA</span>
    </a>

    {/* Menu mobile: disclosure accessibile senza JavaScript */}
    <details class="group relative sm:hidden">
      <summary
        class="focus-visible:outline-brand flex cursor-pointer list-none items-center gap-2 rounded px-3 py-2 text-sm font-semibold focus-visible:outline-2"
        aria-label="Apri il menu"
      >
        Menu
      </summary>
      <nav
        aria-label="Navigazione principale"
        class="absolute right-0 z-10 mt-2 w-52 rounded-lg border border-neutral-200 bg-white p-2 shadow-xl"
      >
        <ul class="flex flex-col gap-1">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="aria-[current=page]:bg-brand/15 aria-[current=page]:text-ink block rounded px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-100 aria-[current=page]:font-semibold"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    {/* Navigazione desktop */}
    <nav aria-label="Navigazione principale" class="hidden sm:block">
      <ul class="flex items-center gap-8 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class={linkBase}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <script is:inline>
    (function () {
      var header = document.getElementById('site-header');
      if (!header) return;
      var onScroll = function () {
        header.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</header>
