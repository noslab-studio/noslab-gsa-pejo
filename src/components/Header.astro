---
import { NAV, SITE_NAME } from '../consts';

// Normalizza il pathname corrente per evidenziare la voce attiva.
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === current;
};
---

<header class="border-b border-white/10">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight text-amber-400"> {SITE_NAME} </a>

    {/* Menu mobile: disclosure accessibile senza JavaScript */}
    <details class="group relative sm:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-amber-400"
        aria-label="Apri il menu"
      >
        Menu
      </summary>
      <nav
        aria-label="Navigazione principale"
        class="absolute right-0 z-10 mt-2 w-48 rounded-lg border border-white/10 bg-neutral-900 p-2 shadow-xl"
      >
        <ul class="flex flex-col gap-1">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="block rounded px-3 py-2 text-sm hover:bg-white/10 aria-[current=page]:text-amber-400"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    {/* Navigazione desktop */}
    <nav aria-label="Navigazione principale" class="hidden sm:block">
      <ul class="flex items-center gap-6 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="text-neutral-300 transition-colors hover:text-white aria-[current=page]:font-medium aria-[current=page]:text-amber-400"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
